# ==============================================================================
# IPROFIXER — HOSTINGER PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env on the production server. Fill every blank value.
# NEVER commit the filled .env to the repository.
# Generate APP_KEY locally with: php artisan key:generate --show
# ==============================================================================

APP_NAME=IProFixer
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_OUTPUT_OF_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://www.iprofixer.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ==============================================================================
# LOGGING
# Use 'errorlog' on Hostinger shared hosting (writes to PHP error log).
# Use 'daily' if you have writable storage/logs/ with log rotation.
# ==============================================================================
LOG_CHANNEL=errorlog
LOG_LEVEL=error

# ==============================================================================
# DATABASE — Hostinger MySQL/MariaDB
# Create the database and user in Hostinger hPanel > Databases.
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_YOUR_HOSTINGER_DB_NAME
DB_USERNAME=REPLACE_WITH_YOUR_HOSTINGER_DB_USER
DB_PASSWORD=REPLACE_WITH_YOUR_HOSTINGER_DB_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ==============================================================================
# SESSION — database driver (no Redis required)
# SESSION_SECURE_COOKIE must be true under HTTPS.
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.iprofixer.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ==============================================================================
# CACHE & QUEUE — database driver (no Redis required on shared hosting)
# ==============================================================================
CACHE_STORE=database
QUEUE_CONNECTION=database

# ==============================================================================
# FILESYSTEM
# Use 'local' — private storage outside public_html.
# RFQ attachments are stored in storage/app/rfq/ and served via authenticated routes.
# ==============================================================================
FILESYSTEM_DISK=local

# ==============================================================================
# MAIL — Hostinger SMTP or external provider (Mailgun, Brevo, etc.)
# Do NOT use log driver in production — submissions would not be acknowledged.
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=REPLACE_WITH_YOUR_SMTP_EMAIL
MAIL_PASSWORD=REPLACE_WITH_YOUR_SMTP_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@iprofixer.com
MAIL_FROM_NAME="IProFixer"

# ==============================================================================
# TRUSTED PROXIES
# Hostinger shared hosting routes requests through their proxy layer.
# * trusts all forwarded headers — adequate for Hostinger shared hosting.
# Narrow to specific IPs if Hostinger provides a fixed proxy IP.
# ==============================================================================
TRUSTED_PROXIES=*

# ==============================================================================
# IPROFIXER OPERATIONS
# RFQ_OPERATIONS_EMAIL receives internal notification for every new RFQ.
# ==============================================================================
RFQ_OPERATIONS_EMAIL=ops@iprofixer.com
RFQ_FIRST_RESPONSE_HOURS=4
RFQ_STALE_CONTACT_HOURS=48

# ==============================================================================
# VITE (build-time only — not needed in production .env after npm run build)
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
